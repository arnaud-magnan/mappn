# Database Configuration
DATABASE_URL=postgresql+asyncpg://mappn:secret@localhost:5432/mappn

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars-required
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Visit Tracking Configuration
GEOFENCE_RADIUS_M=75
VISIT_MIN_DURATION_SECONDS=300
VISIT_MIN_READINGS=3

# Outscraper API
OUTSCRAPER_API_KEY=

# Application
DEBUG=False
LOG_LEVEL=INFO
